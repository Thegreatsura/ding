{
  "name": "ding-react",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --external react",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "ding": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": ">=18"
  },
  "description": "React renderer for Ding spring-physics toasts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YusufCeng1z/ding.git",
    "directory": "packages/react"
  },
  "keywords": [
    "toast",
    "notification",
    "spring",
    "animation",
    "react"
  ],
  "engines": {
    "node": ">=18"
  }
}
